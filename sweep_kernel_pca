from sklearn.decomposition import KernelPCA

from model import MNISTCNY19
from compare_with_baseline import load_keras_weights
from run_baseline import load, extract, take, stats, LAYERS, DEVICE, seed_all
from monitor_rotated import MultiLayerMonitor, RotatedBox

# =====================================================================
# This file only RUNS: "rotated" and "kpca" (kernel PCA + plain Box).
# Other methods are NOT recomputed: they are read from the old CSV files and shown
# in the same tables. Same split, seeds, epsilon grid and selection rule as before.
# =====================================================================
MODELS_DIR = r"C:\work\original\models"
THRESHOLD = 0.07                       # same as all earlier experiments
FIT_EPS = 0.0                          # same as before

PRESET = "final"
#   "quick_test" : seed 0, n=3 (check for typos and see the run time first)
#   "final"      : seeds 0,1,2 and n = 2..9, same as the earlier final runs

PRESETS = {
    "quick_test": dict(seeds=[0], n_range=[3], out="results_kpca_quick_test.csv"),
    "final":      dict(seeds=[0, 1, 2], n_range=list(range(2, 10)), out="results_kpca_final.csv"),
}
cfg = PRESETS[PRESET]
SEEDS, N_RANGE, OUT_FILE = cfg["seeds"], cfg["n_range"], cfg["out"]

RUN = ["rotated", "kpca"]              # remove "rotated" if you do not want to recompute it (it is deterministic)

# Earlier results to show next to the new ones (not recomputed): (csv file, methods to read).
# Files that do not exist are skipped.
OLD_SOURCES = [("results_final_v2.csv", ["box", "adaptive_validation"]),
               ("results_ocsvm_final.csv", ["ocsvm"])]

# =====================================================================
# SELECTION SETTINGS: identical to the earlier experiments
# =====================================================================
VAL_FRAC = 0.2                         # same 20% held-out known training points
TARGET_FW = 0.05                       # selected epsilon = smallest one whose validation FW <= 5%
EPSILONS = [0.0, 0.05, 0.1, 0.2, 0.3, 0.5]

# =====================================================================
# KERNEL PCA SETTINGS: fixed, standard values, NOT tuned on anything
# =====================================================================
KPCA_LAYERS = [-2, -3, -4]             # layer -1 stays raw, as in every other method
KPCA_LANDMARKS = 3000                  # kernel PCA is fitted on this many FIT points (the kernel matrix must fit in memory)
# kernel = RBF, gamma = 1 / (dimension * variance) (same "scale" rule as the kernel SVM),
# n_components = layer dimension, so a kpca box has as many sides as an ordinary box.

ROT_LAYERS = [-2, -3, -4]
SHAPES = {"rotated": {l: RotatedBox for l in ROT_LAYERS},
          "kpca": None}                # plain Box, but on the kernel-PCA coordinates


def transform_chunks(kp, X, size=5000):
    """kp.transform in chunks, so the (points x landmarks) kernel matrix never gets huge."""
    return np.vstack([kp.transform(np.asarray(X[i:i + size], dtype=np.float64))
                      for i in range(0, len(X), size)])


def apply_kpca(V_fit, sets, seed):
    """One kernel-PCA map per layer, fitted on (a subsample of) the FIT part only, then applied to
    the fit part and to every other set (validation / test) with the SAME map."""
    Vf, out, info = dict(V_fit), {k: dict(v) for k, v in sets.items()}, []
    for l in KPCA_LAYERS:
        X = V_fit[l]
        rng = np.random.default_rng(seed * 100 + abs(l))
        sub = np.asarray(X[rng.choice(len(X), min(KPCA_LANDMARKS, len(X)), replace=False)], dtype=np.float64)
        gamma = 1.0 / (sub.shape[1] * sub.var() + 1e-12)
        kp = KernelPCA(n_components=sub.shape[1], kernel="rbf", gamma=gamma).fit(sub)
        Vf[l] = transform_chunks(kp, X)
        for k in out:
            out[k][l] = transform_chunks(kp, sets[k][l])
        info.append(f"{l}:{kp.transform(sub[:1]).shape[1]}")
    return Vf, out, ";".join(info)


def test_rates(r):
    return (100 * r["nov_det"] / (r["nov_det"] + r["nov_undet"]),
            100 * r["fp"] / (r["fp"] + r["tn"]))


def load_old(sources):
    """Saved results of the earlier runs: validation-selected rows only, same n and seeds."""
    out = []
    for path, methods in sources:
        if not os.path.exists(path):
            print(f"(old results not found, skipped: {path})")
            continue
        with open(path, newline="") as f:
            for r in csv.DictReader(f):
                if r["method"] in methods and r["selected"] == "True":
                    for k in ("tn", "fp", "nov_det", "nov_undet", "n_classes", "seed"):
                        r[k] = int(r[k])
                    for k in ("epsilon", "val_fw_pct", "n_clusters", "fit_s"):
                        r[k] = float(r[k])
                    if r["n_classes"] in N_RANGE and r["seed"] in SEEDS:
                        out.append(r)
    return out


def print_table(rs):
    """Validation-selected epsilon only: one line per method (mean over the rows given)."""
    print(f"{'method':22s}{'eps':>6s}{'valFW%':>8s}{'det%':>8s}{'FW%':>8s}{'clusters':>10s}{'fit_s':>8s}")
    for label in dict.fromkeys(r["method"] for r in rs):
        g = [r for r in rs if r["method"] == label]
        t = np.array([test_rates(r) for r in g])
        print(f"{label:22s}{np.mean([r['epsilon'] for r in g]):6.2f}{np.mean([r['val_fw_pct'] for r in g]):8.1f}"
              f"{t[:, 0].mean():8.1f}{t[:, 1].mean():8.1f}"
              f"{np.mean([r['n_clusters'] for r in g]):10.1f}{np.mean([r['fit_s'] for r in g]):8.1f}")


def print_grid(rs):
    """All epsilons (new methods): cell = test detected% / test false-warning%."""
    print(f"{'method':22s}" + "".join(f"{'eps=' + str(e):>13s}" for e in EPSILONS))
    for label in dict.fromkeys(r["method"] for r in rs):
        line = f"{label:22s}"
        for e in EPSILONS:
            g = [r for r in rs if r["method"] == label and r["epsilon"] == e]
            t = np.array([test_rates(r) for r in g])
            line += f"{t[:, 0].mean():6.1f}/{t[:, 1].mean():5.1f} "
        print(line)


def report(new_rows, old_rows, title):
    print(f"\n--- {title}: epsilon selected on validation (mean over seeds; older methods read from saved CSVs) ---")
    print_table(old_rows + [r for r in new_rows if r["selected"]])
    print(f"\n--- {title}: ALL epsilons, new methods, cell = test det% / test FW% (do not pick the best from here) ---")
    print_grid(new_rows)


def save():
    with open(OUT_FILE, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=rows[0].keys())
        w.writeheader(); w.writerows(rows)


# =====================================================================
# EXPERIMENT
# =====================================================================
print(f"PRESET = {PRESET} | methods run now = {RUN} | seeds = {SEEDS} | n = {N_RANGE}")
print(f"kpca: RBF kernel, gamma = 1/(d*var), {KPCA_LANDMARKS} fit landmarks, n_components = layer dim, then plain Box")
print(f"selected epsilon = smallest one with validation FW <= {100 * TARGET_FW:.0f}% (known held-out training points)")
x_tr, y_tr, x_te, y_te = load()
old = load_old(OLD_SOURCES)
rows = []

for n in N_RANGE:
    model = MNISTCNY19(n)
    load_keras_weights(model, rf"{MODELS_DIR}\CNY19id1_MNIST_0-{n-1}.h5")
    model.to(DEVICE).eval()

    tr, te = y_tr < n, y_te < n
    V_tr = extract(model, x_tr[tr]); gt_tr = y_tr[tr]
    ok = V_tr[-1].argmax(1) == gt_tr
    V_ok, y_ok = take(V_tr, ok), gt_tr[ok]           # known, correctly classified training points
    V_run = extract(model, x_te)
    pred = V_run[-1].argmax(1)                       # always from the RAW outputs
    correct = pred == y_te
    print(f"\nn={n}: accuracy on known digits = {correct[te].mean():.4f}")

    for seed in SEEDS:
        # identical split to the earlier runs (same seed -> same permutation)
        is_val = np.zeros(len(y_ok), dtype=bool)
        is_val[np.random.default_rng(seed).permutation(len(y_ok))[:int(VAL_FRAC * len(y_ok))]] = True
        V_fit, y_fit = take(V_ok, ~is_val), y_ok[~is_val]
        V_val, y_val = take(V_ok, is_val), y_ok[is_val]
        sets = {"val": V_val, "test": V_run}

        for name in RUN:
            seed_all(seed)                           # same k-means seed as in the earlier runs
            mon = MultiLayerMonitor(LAYERS, shape_by_layer=SHAPES[name], threshold=THRESHOLD, epsilon=FIT_EPS)

            t0 = time.perf_counter()
            kinfo = ""
            if name == "kpca":
                Vf, S, kinfo = apply_kpca(V_fit, sets, seed)    # map fitted on the fit part only
            else:
                Vf, S = V_fit, sets
            map_s = time.perf_counter() - t0

            t0 = time.perf_counter()
            mon.fit(Vf, y_fit, n)
            fit_s = time.perf_counter() - t0

            shapes = [s for m in mon.mons.values() for lst in m.shapes.values() for s in lst]
            base = dict(seed=seed, n_classes=n, method=name, n_clusters=len(shapes),
                        n_rotated=sum(isinstance(s, RotatedBox) for s in shapes),
                        fit_s=round(fit_s, 3), map_s=round(map_s, 3), kpca_dims=kinfo)

            mine, chosen = [], None
            for eps in EPSILONS:
                for m in mon.mons.values():
                    m.epsilon = eps
                val_fw = 1 - mon.accepts(S["val"], y_val).mean()
                if chosen is None and val_fw <= TARGET_FW:
                    chosen = eps                     # selection uses validation only
                acc = mon.accepts(S["test"], pred)
                row = dict(base, epsilon=eps, val_fw_pct=round(100 * val_fw, 2))
                row.update(stats(correct, acc, y_te, n))
                mine.append(row)
            reached = chosen is not None
            if not reached:
                chosen = EPSILONS[-1]
            for r in mine:
                r["selected"] = (r["epsilon"] == chosen)
                r["target_reached"] = reached
            rows.extend(mine)

            s = next(r for r in mine if r["selected"])
            det, fw = test_rates(s)
            print(f"   n={n} seed={seed} {name:10s} selected eps={chosen:<4} valFW={s['val_fw_pct']:4.1f}% | "
                  f"test det {det:5.1f}%  FW {fw:4.1f}% | map {map_s:.0f}s fit {fit_s:.0f}s"
                  + ("" if reached else "  (target FW not reached)"))

    report([r for r in rows if r["n_classes"] == n], [r for r in old if r["n_classes"] == n], f"n={n}")
    save()                                           # saved after every n

report(rows, old, "OVERALL (all n, all seeds)")
print("saved", OUT_FILE)